    {
      "parameters": {
        "jsCode": "const issues = $('Get open issues').all();\n\nconst byNumber = (a, b) => a.json.number - b.json.number;\nconst hasLabel = (item, name) =>\n  (item.json.labels || []).some(label => label.name === name);\n\nreturn {\n  inProgress: issues.filter(i => hasLabel(i, 'ai-in-progress')).sort(byNumber),\n  inQueue: issues.filter(i => hasLabel(i, 'ai-fix')).sort(byNumber),\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        0
      ],
      "id": "badbfc8f-ee5c-4e81-adef-a432406ebf79",
      "name": "Classify issues"
    },
    {
      "parameters": {
        "jsCode": "const labels = $input.all().map(item => item.json);\n\nconst aiFix = labels.find(l => l.name === 'ai-fix');\nconst aiInProgress = labels.find(l => l.name === 'ai-in-progress');\nconst aiNeedsHuman = labels.find(l => l.name === 'ai-needs-human');\nconst aiReview = labels.find(l => l.name === 'ai-review');\n\nreturn {\n  aiFixId: aiFix.id,\n  aiInProgressId: aiInProgress.id,\n  aiNeedsHumanId: aiNeedsHuman.id,\n  aiReviewId: aiReview.id\n};"
      },
      "type": "n8n-nodes-base.code",

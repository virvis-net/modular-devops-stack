    {
      "parameters": {
        "jsCode": "const issue = $('Select queued issue').first().json;\n\n// \"Always Output Data\" can add an empty item, so keep only real rows\nconst previous = $('Get previous attempts').all()\n  .map(i => i.json)\n  .filter(r => r.attempt !== undefined && r.attempt !== null);\n\nconst attempt = previous.reduce((max, r) => Math.max(max, Number(r.attempt)), 0) + 1;\n\nconst number = Number(issue.number);\nif (!Number.isInteger(number) || number <= 0) {\n  throw new Error(`Invalid issue number: ${issue.number}`);\n}\n\nconst slug = String(issue.title ?? '')\n  .normalize('NFKD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '');\n\nconst base = slug ? `issue/${number}-${slug}` : `issue/${number}`;\nconst branchName = attempt === 1 ? base : `${base}-attempt-${attempt}`;\n\nreturn [{ json: { ...issue, attempt, branch_name: branchName } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

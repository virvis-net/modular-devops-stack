      "name": "Prompt template"
    },
    {
      "parameters": {
        "jsCode": "const issue = $('Branch name').first().json; // number, title, body, branch_name\n\nif ($input.all().length !== 2) {\n  throw new Error('Expected 2 prompt files (generic and stack), got ' + $input.all().length + '. Check PROMPT_STACK and the files in /assets/prompts/stacks');\n}\nconst nl = String.fromCharCode(10);\nconst generic = (await this.helpers.getBinaryDataBuffer(0, 'prompt_template')).toString('utf8');\nconst stack = (await this.helpers.getBinaryDataBuffer(1, 'prompt_template')).toString('utf8');\nconst template = generic.trimEnd() + nl + nl + stack.trim() + nl;\n\nif (!issue.title) throw new Error('Issue has no title');\nif (!issue.branch_name) throw new Error('Issue has no branch_name');\nif (!template.includes('\\n')) {\n  throw new Error('Template has no line breaks: it was probably pasted into a single-line field');\n}\n\n// Wrap in single quotes, escaping any single quote inside the text\nconst shellQuote = (s) => \"'\" + String(s).replace(/'/g, \"'\\\\''\") + \"'\";\n\nconst values = {\n  ISSUE_NUMBER: String(issue.number),\n  ISSUE_TITLE: issue.title,\n  ISSUE_TITLE_SHELL: shellQuote(issue.title),\n  BRANCH_NAME: issue.branch_name,\n  ISSUE_BODY: (issue.body || '(no description)')\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/<\\/issue-body>/gi, ''),\n};\n\n// Single pass, accepting {{NAME}} and [[NAME]]. Text inside the issue is never re-scanned.\nconst unknown = [];\nlet replaced = 0;\nconst prompt = template.replace(\n  /\\{\\{\\s*(\\w+)\\s*\\}\\}|\\[\\[\\s*(\\w+)\\s*\\]\\]/g,\n  (m, a, b) => {\n    const key = a || b;\n    if (!Object.hasOwn(values, key)) {\n      unknown.push(key);\n      return m;\n    }\n    replaced++;\n    return values[key];\n  }\n);\nif (unknown.length) {\n  throw new Error(`Unknown placeholders in template: ${unknown.join(', ')}`);\n}\nif (replaced === 0) {\n  throw new Error('Template contains no placeholders');\n}\n\n// Small version stamp so you can tell which template produced which run\nlet h = 5381;\nfor (const ch of template) h = ((h * 33) ^ ch.codePointAt(0)) >>> 0;\n\nreturn [{ json: { ...issue, prompt, prompt_version: h.toString(16) }, pairedItem: { item: 0 } }];"
      },

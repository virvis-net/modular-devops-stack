# ─────────────────────────────
# GLOBAL SETTINGS
# ─────────────────────────────
STACK_NAME=mds
NETWORK_NAME=${STACK_NAME}-network

# ─────────────────────────────
# SOURCE CONTROL (Gitea)
# ─────────────────────────────
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_SSH_DOMAIN=host.docker.internal
GITEA_ROOT_URL=http://host.docker.internal:${GITEA_HTTP_PORT}
GITEA_ALLOWED_HOSTS=192.168.65.0/24,172.23.0.0/16,::1
GITEA_ADMIN_USER=your_gitea_username
GITEA_ORG=${GITEA_ADMIN_USER}
GITEA_CLIENT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GITEA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────
# CI (Woodpecker)
# ─────────────────────────────
WOODPECKER_PORT=8000
WOODPECKER_HOST=http://host.docker.internal:${WOODPECKER_PORT}
WOODPECKER_ADMIN=${GITEA_ADMIN_USER}
WOODPECKER_AGENT_SECRET=supersecret
WOODPECKER_GITEA_URL=http://host.docker.internal:${GITEA_HTTP_PORT}

# ─────────────────────────────
# REGISTRY
# ─────────────────────────────
REGISTRY_PORT=5000

# ─────────────────────────────
# CLUSTER (k3d)
# ─────────────────────────────
K3D_CLUSTER_PORT=80
K3D_CLUSTER_PORT_SSL=443
K3D_CLUSTER_NAME=${STACK_NAME}-cluster

# ─────────────────────────────
# GITOPS (Flux)
# ─────────────────────────────
GITOPS_REPO_URL=ssh://git@${GITEA_SSH_DOMAIN}:${GITEA_SSH_PORT}/${GITEA_ORG}/gitops.git
GITOPS_BRANCH=main
GITOPS_PATH=clusters/${K3D_CLUSTER_NAME}

# ─────────────────────────────
# OPTIONAL CENTRAL TELEMETRY
# ─────────────────────────────
# Leave the defaults for stack-local Collector -> Tempo/Loki behavior.
# Set OTEL_CENTRAL_INGEST_ENABLED=true on the central stack to expose its
# Collector over HTTP(S)/Basic Auth. This example endpoint uses HTTP while
# ingestion is disabled. HTTP is the local multi-stack example; HTTPS is also
# supported by changing the endpoint and setup helper scheme.
# Secret names are fixed in the manifests; create them as documented in the
# monitoring README.
# In the two-stack Vue/Laravel exercise, the frontend stack could be central
# and the API stack forwards to this endpoint, or the other way around; the
# fresh-install defaults stay local.
OTEL_CENTRAL_INGEST_ENABLED=false
# Choose local (default), forward (central only), or both (local and central).
OTEL_CENTRAL_EXPORT_MODE=local
# Example default central HTTP port: 80. The central stack may use another
# available host port; configure every forwarder with that actual central port.
# Ingest-enabled stack: this is its public origin. Forwarding stack: this is
# the central stack's origin. Use the central host port, not this stack's port.
# HTTPS requires a trusted certificate; HTTP is allowed only for trusted labs.
OTEL_CENTRAL_COLLECTOR_ENDPOINT=http://host.k3d.internal:80

# ─────────────────────────────
# Other optional settings
# ─────────────────────────────
# Optional path override; default: stack/.state/ssh/flux_deploy_key
# FLUX_PRIVATE_KEY=/path/to/flux_deploy_key

# ─────────────────────────────
# GLOBAL SETTINGS
# ─────────────────────────────
STACK_NAME=mds
NETWORK_NAME=${STACK_NAME}-network

# ─────────────────────────────
# SOURCE CONTROL (Gitea)
# ─────────────────────────────
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_SSH_DOMAIN=host.docker.internal
GITEA_ROOT_URL=http://host.docker.internal:${GITEA_HTTP_PORT}
GITEA_ALLOWED_HOSTS=192.168.65.0/24,172.23.0.0/16,::1
GITEA_CLIENT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GITEA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────
# CI (Woodpecker)
# ─────────────────────────────
WOODPECKER_PORT=8000
WOODPECKER_HOST=http://ci-server:8000
WOODPECKER_AGENT_SECRET=supersecret
WOODPECKER_GITEA_URL=http://host.docker.internal:${GITEA_HTTP_PORT}

# ─────────────────────────────
# REGISTRY
# ─────────────────────────────
REGISTRY_PORT=5000
REGISTRY_URL=http://registry:5000

# ─────────────────────────────
# CLUSTER (k3d)
# ─────────────────────────────
K3D_CLUSTER_PORT=80
K3D_CLUSTER_PORT_SSL=443
K3D_CLUSTER_NAME=${STACK_NAME}-cluster

# ─────────────────────────────
# GITOPS (Flux)
# ─────────────────────────────
GITOPS_REPO_URL=ssh://git@${GITEA_SSH_DOMAIN}:${GITEA_SSH_PORT}/${STACK_NAME}/gitops.git
GITOPS_BRANCH=main
GITOPS_PATH=clusters/${K3D_CLUSTER_NAME}
